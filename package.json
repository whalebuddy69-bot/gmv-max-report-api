{
  "name": "gmv-max-report",
  "version": "0.1.0",
  "private": true,
  "description": "Internal HTTP service that pulls TikTok Shop GMV Max performance reports and exports them as .xlsx for the agency team",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r reflect-metadata src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node -r reflect-metadata dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:video-metadata": "node -r reflect-metadata dist/db/migrateVideoMetadata.js",
    "create-user": "ts-node -P tsconfig.scripts.json -r reflect-metadata scripts/createUser.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^3.0.3",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.15",
    "@types/node-cron": "^3.0.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
